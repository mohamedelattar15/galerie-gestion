+.modal-backdrop { position: fixed; inset: 0; z-index: 60; display: grid; place-items: center; padding: 1rem; background: rgb(8 8 16 / 55%); backdrop-filter: blur(3px); animation: fade 0.15s; }
+.modal { display: grid; gap: 0.6rem; width: min(100%, 24rem); padding: 1.5rem; border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow-lg); }
+.modal-actions { display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 0.75rem; }
+.toasts { position: fixed; right: 1.25rem; bottom: 1.25rem; z-index: 80; display: grid; gap: 0.6rem; width: min(24rem, calc(100% - 2.5rem)); }
+.toast {
+  display: flex; align-items: flex-start; gap: 0.65rem; padding: 0.8rem 0.9rem; border: 1px solid var(--line);
+  border-left: 4px solid var(--good); border-radius: var(--radius-sm); background: var(--surface);
+  box-shadow: var(--shadow-md); font-size: 0.88rem; animation: slide 0.25s;
+}
